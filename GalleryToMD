def main():
parser = argparse.ArgumentParser(
description=(
“Convert Sebastian Raschka’s LLM Architecture Gallery into “
“structured Markdown for autoresearch agents.”
),
formatter_class=argparse.RawDescriptionHelpFormatter,
epilog=(
“Examples:\n”
“  python gallery_to_md.py –output pool.md\n”
“  python gallery_to_md.py –output pool.md –json pool.json –force-refresh\n”
“  python gallery_to_md.py –output pool.md –yaml pool.yaml\n”
“  python gallery_to_md.py –diff\n”
),
)
parser.add_argument(
“–output”, “-o”,
type=Path,
default=Path(“llm_ideas_pool.md”),
help=“Output Markdown file (default: llm_ideas_pool.md)”,
)
parser.add_argument(
“–json”, “-j”,
type=Path,
default=None,
help=“Also export as JSON”,
)
parser.add_argument(
“–yaml”, “-y”,
type=Path,
default=None,
help=“Also export as YAML”,
)
parser.add_argument(
“–force-refresh”, “-f”,
action=“store_true”,
help=“Ignore cache and re-fetch from the web”,
)
parser.add_argument(
“–diff”, “-d”,
action=“store_true”,
help=“Show changes since last generated version”,
)
parser.add_argument(
“–quiet”, “-q”,
action=“store_true”,
help=“Suppress info-level logging”,
)

```
args = parser.parse_args()

if args.quiet:
    logging.getLogger("gallery_to_md").setLevel(logging.WARNING)

# Fetch and parse
html = fetch_gallery(force_refresh=args.force_refresh)
gallery = parse_gallery(html)

if not gallery.models:
    log.error("No models parsed — the page structure may have changed.")
    log.error("Try running with --force-refresh or check the gallery URL.")
    sys.exit(1)

# Generate markdown
md = generate_markdown(gallery)

# Diff mode
if args.diff:
    diff_result = diff_galleries(args.output, md)
    print("\n=== Gallery Diff ===")
    print(diff_result)
    print()

# Write outputs
args.output.write_text(md, encoding="utf-8")
log.info(f"Markdown written to {args.output} ({len(md):,} chars, {len(gallery.models)} models)")

if args.json:
    export_json(gallery, args.json)

if args.yaml:
    export_yaml(gallery, args.yaml)

# Print summary
print(f"\n{'='*60}")
print(f"  LLM Architecture Gallery → Pool of Ideas")
print(f"{'='*60}")
print(f"  Models parsed:   {len(gallery.models)}")
print(f"  Upcoming:        {len(gallery.upcoming_models)}")
print(f"  Output:          {args.output}")
if args.json:
    print(f"  JSON:            {args.json}")
if args.yaml:
    print(f"  YAML:            {args.yaml}")
print(f"  Markdown size:   {len(md):,} characters")
print(f"{'='*60}\n")
```

if **name** == “**main**”:
main()
