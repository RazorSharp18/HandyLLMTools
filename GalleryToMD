# Parsing

# —————————————————————————

def parse_gallery(html: str) -> GalleryData:
“”“Parse the gallery HTML into structured data.”””
soup = BeautifulSoup(html, “html.parser”)
gallery = GalleryData(
fetched_at=datetime.now(timezone.utc).strftime(”%Y-%m-%d %H:%M UTC”),
)

```
# The gallery uses a BEM structure:
#   <article class="llm-architecture-overview__card">
#     <img ...>  (diagram)
#     <span class="llm-architecture-overview__body">
#       <div class="__title-row"> → <h3>, links
#       <div class="__fact-sheet"> → <p> summary, <dl> specs, concepts
cards = soup.find_all("article", class_="llm-architecture-overview__card")
log.info(f"Found {len(cards)} model card(s)")

for card in cards:
    model = parse_model_card(card)
    if model and model.name:
        gallery.models.append(model)

# Fallback: if no BEM cards found, try the h3-based approach
if not gallery.models:
    log.warning("No BEM cards found, falling back to h3-based parsing")
    for h3 in soup.find_all("h3"):
        model = parse_model_entry_fallback(h3)
        if model and model.name:
            gallery.models.append(model)

# Extract upcoming models from the nav/toc links at the top
nav_links = soup.find_all("a", href=re.compile(r"#section-"))
for link in nav_links:
    name = link.get_text(strip=True)
    existing_names = {m.name.lower() for m in gallery.models}
    if name.lower() not in existing_names and name:
        gallery.upcoming_models.append(name)

# Extract source articles
for h2 in soup.find_all("h2"):
    text = h2.get_text(strip=True)
    if "Architecture Comparison" in text or "Dream of Spring" in text:
        link = h2.find("a")
        if link:
            gallery.source_articles.append({
                "title": text,
                "url": link.get("href", ""),
            })

log.info(
    f"Parsed {len(gallery.models)} models, "
    f"{len(gallery.upcoming_models)} upcoming, "
    f"{len(gallery.source_articles)} source articles"
)
return gallery
```

def parse_model_card(card: Tag) -> Optional[ModelEntry]:
“”“Parse a single model card from an <article> BEM element.”””
# Model name from h3
h3 = card.find(“h3”, class_=“llm-architecture-overview__title”)
if not h3:
return None
name = h3.get_text(strip=True)
if not name:
return None

```
model = ModelEntry(name=name)

# Section ID from the card
model.section_id = card.get("id", "")

# Diagram image (direct child <img> of the card, before the body)
img = card.find("img")
if img:
    src = img.get("src", "")
    if src and not src.startswith("http"):
        src = f"https://sebastianraschka.com{src}"
    model.diagram_url = src
    model.diagram_alt = img.get("alt", "")

# Links from the title-meta section
meta_div = card.find("div", class_="llm-architecture-overview__title-meta")
if meta_div:
    for link in meta_div.find_all("a"):
        href = link.get("href", "")
        text = link.get_text(strip=True)
        if "View in article" in text:
            model.article_url = href
        elif "From scratch" in text:
            model.from_scratch_url = href
        elif "config.json" in text or "params.json" in text:
            model.config_json_url = href
        elif "Tech report" in text:
            model.tech_report_url = href

# Summary paragraph
summary_p = card.find("p", class_="llm-architecture-overview__fact-summary")
if summary_p:
    model.summary = summary_p.get_text(strip=True)

# Fact grid: <dl> with <dt>/<dd> pairs wrapped in <div> items
fact_grid = card.find("dl", class_="llm-architecture-overview__fact-grid")
if fact_grid:
    items = fact_grid.find_all("div", class_="llm-architecture-overview__fact-item") or []
    # Also try direct dt/dd pairs
    if not items:
        dts = fact_grid.find_all("dt")
        dds = fact_grid.find_all("dd")
        for dt, dd in zip(dts, dds):
            _assign_fact(model, dt.get_text(strip=True), dd.get_text(strip=True))
    else:
        for item in items:
            dt = item.find("dt")
            dd = item.find("dd")
            if dt and dd:
                _assign_fact(model, dt.get_text(strip=True), dd.get_text(strip=True))

# Related concepts
concepts_div = card.find("div", class_="llm-architecture-overview__concepts-links")
if concepts_div:
    for link in concepts_div.find_all("a"):
        concept = link.get_text(strip=True)
        if concept and concept not in model.related_concepts:
            model.related_concepts.append(concept)

return model
```

def _assign_fact(model: ModelEntry, key: str, val: str) -> None:
“”“Assign a fact-grid key/value pair to the appropriate model field.”””
k = key.lower()
if “scale” in k:
model.scale = val
elif “date” in k:
model.date = val
elif “decoder” in k:
model.decoder_type = val
elif “attention” in k:
model.attention = val
elif “key detail” in k:
model.key_detail = val

def parse_model_entry_fallback(h3: Tag) -> Optional[ModelEntry]:
“”“Fallback parser for pages without BEM class structure.”””
name = h3.get_text(strip=True)
if not name or name.startswith(“©”):
return None
model = ModelEntry(name=name)

```
prev_img = h3.find_previous("img")
if prev_img:
    src = prev_img.get("src", "")
    if "architectures/" in src:
        if not src.startswith("http"):
            src = f"https://sebastianraschka.com{src}"
        model.diagram_url = src
        model.diagram_alt = prev_img.get("alt", "")

for sib in h3.find_next_siblings():
    if sib.name in ("h3", "h2"):
        break
    if not isinstance(sib, Tag):
        continue
    for link in sib.find_all("a"):
        href = link.get("href", "")
        text = link.get_text(strip=True)
        if "View in article" in text:
            model.article_url = href
        elif "From scratch" in text:
            model.from_scratch_url = href
        elif "config.json" in text:
            model.config_json_url = href
        elif "Tech report" in text:
            model.tech_report_url = href

    for dl in ([sib] if sib.name == "dl" else sib.find_all("dl")):
        for dt, dd in zip(dl.find_all("dt"), dl.find_all("dd")):
            _assign_fact(model, dt.get_text(strip=True), dd.get_text(strip=True))

return model
```

