# Diff support

# —————————————————————————

def diff_galleries(old_path: Path, new_md: str) -> str:
“”“Compare new markdown against a previously saved version.”””
if not old_path.exists():
return “No previous version found — nothing to diff.”

```
old_lines = old_path.read_text(encoding="utf-8").splitlines()
new_lines = new_md.splitlines()

# Simple diff: find added/removed model names
old_models = {l.strip("# ").strip() for l in old_lines if l.startswith("### ")}
new_models = {l.strip("# ").strip() for l in new_lines if l.startswith("### ")}

added = new_models - old_models
removed = old_models - new_models

parts = []
if added:
    parts.append(f"NEW models ({len(added)}): {', '.join(sorted(added))}")
if removed:
    parts.append(f"REMOVED models ({len(removed)}): {', '.join(sorted(removed))}")
if not parts:
    parts.append("No model-level changes detected.")

return "\n".join(parts)
```

