def to_dict(self) -> dict:
    return {k: v for k, v in asdict(self).items() if v}
```

@dataclass
class GalleryData:
“”“Top-level container for the entire gallery.”””
source_url: str = GALLERY_URL
fetched_at: str = “”
models: list[ModelEntry] = field(default_factory=list)
upcoming_models: list[str] = field(default_factory=list)
source_articles: list[dict] = field(default_factory=list)

```
def to_dict(self) -> dict:
    return {
        "source_url": self.source_url,
        "fetched_at": self.fetched_at,
        "model_count": len(self.models),
        "models": [m.to_dict() for m in self.models],
        "upcoming_models": self.upcoming_models,
        "source_articles": self.source_articles,
    }
```

