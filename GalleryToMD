def export_json(gallery: GalleryData, path: Path) -> None:
“”“Export gallery data as JSON.”””
data = gallery.to_dict()
path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding=“utf-8”)
log.info(f”JSON exported to {path}”)

def export_yaml(gallery: GalleryData, path: Path) -> None:
“”“Export gallery data as YAML.”””
data = gallery.to_dict()
path.write_text(
yaml.dump(data, default_flow_style=False, allow_unicode=True, sort_keys=False),
encoding=“utf-8”,
)
log.info(f”YAML exported to {path}”)

