# Markdown generation

# —————————————————————————

def generate_markdown(gallery: GalleryData) -> str:
“”“Generate clean, structured Markdown from the gallery data.”””
lines = []
w = lines.append  # shorthand

```
w("# LLM Architecture Gallery — Machine-Readable Pool of Ideas")
w("")
w("## Metadata")
w("")
w(f"- **Source**: <{gallery.source_url}>")
w(f"- **Last fetched**: {gallery.fetched_at}")
w(f"- **Maintained by**: Sebastian Raschka")
w(f"- **Total models**: {len(gallery.models)}")
w(f"- **Purpose** (per Karpathy): Pool of architecture ideas for autoresearch agents")
w("")

if gallery.source_articles:
    w("### Source Articles")
    w("")
    for art in gallery.source_articles:
        w(f"- [{art['title']}]({art['url']})")
    w("")

w("---")
w("")
w("## Models")
w("")

# Group models by decoder type for easier browsing
dense = [m for m in gallery.models if "dense" in m.decoder_type.lower()]
moe = [m for m in gallery.models if "moe" in m.decoder_type.lower() and "hybrid" not in m.decoder_type.lower()]
hybrid = [m for m in gallery.models if "hybrid" in m.decoder_type.lower()]
other = [m for m in gallery.models if m not in dense and m not in moe and m not in hybrid]

# Quick index
w("### Quick Index by Architecture Type")
w("")
if dense:
    w(f"**Dense** ({len(dense)}): " + ", ".join(f"[{m.name}](#{slugify(m.name)})" for m in dense))
if moe:
    w(f"**Sparse MoE** ({len(moe)}): " + ", ".join(f"[{m.name}](#{slugify(m.name)})" for m in moe))
if hybrid:
    w(f"**Hybrid** ({len(hybrid)}): " + ", ".join(f"[{m.name}](#{slugify(m.name)})" for m in hybrid))
if other:
    w(f"**Other** ({len(other)}): " + ", ".join(f"[{m.name}](#{slugify(m.name)})" for m in other))
w("")
w("---")
w("")

# Render each model
for i, model in enumerate(gallery.models, 1):
    w(f"### {model.name}")
    w("")

    if model.summary:
        w(f"> {model.summary}")
        w("")

    # Structured specs table
    specs = []
    if model.scale:
        specs.append(("Scale", model.scale))
    if model.date:
        specs.append(("Release date", model.date))
    if model.decoder_type:
        specs.append(("Decoder type", model.decoder_type))
    if model.attention:
        specs.append(("Attention", model.attention))
    if model.key_detail:
        specs.append(("Key detail", model.key_detail))

    if specs:
        w("| Property | Value |")
        w("|----------|-------|")
        for key, val in specs:
            w(f"| {key} | {val} |")
        w("")

    # Related concepts as tags
    if model.related_concepts:
        w(f"**Related concepts**: {', '.join(model.related_concepts)}")
        w("")

    # Links
    links = []
    if model.config_json_url:
        links.append(f"[config.json]({model.config_json_url})")
    if model.tech_report_url:
        links.append(f"[Tech report]({model.tech_report_url})")
    if model.article_url:
        links.append(f"[Article section]({model.article_url})")
    if model.from_scratch_url:
        links.append(f"[From scratch]({model.from_scratch_url})")
    if links:
        w(f"**Links**: {' · '.join(links)}")
        w("")

    # Diagram
    if model.diagram_url:
        alt = model.diagram_alt or f"{model.name} architecture diagram"
        w(f"**Diagram**: ![{alt}]({model.diagram_url})")
        w("")

    w("---")
    w("")

# Upcoming / announced models
if gallery.upcoming_models:
    w("## Upcoming / Announced Models")
    w("")
    w("The following models appear in the gallery navigation but do not yet have")
    w("full architecture cards:")
    w("")
    for name in gallery.upcoming_models:
        w(f"- {name}")
    w("")

# Appendix: Cross-reference tables
w("## Appendix: Architecture Feature Matrix")
w("")
w("A quick-scan matrix for autoresearch agents to compare design choices at a glance.")
w("")
w("| Model | Scale | Type | Attention | Key Innovation |")
w("|-------|-------|------|-----------|----------------|")
for m in gallery.models:
    scale = m.scale.replace("|", "/")
    attn = m.attention.replace("|", "/")
    key = m.key_detail[:80].replace("|", "/") if m.key_detail else "—"
    w(f"| {m.name} | {scale} | {m.decoder_type} | {attn} | {key} |")
w("")

# Concept frequency
w("## Appendix: Concept Frequency")
w("")
w("How often each architectural concept appears across the gallery, useful for")
w("identifying dominant and emerging patterns.")
w("")
concept_count: dict[str, int] = {}
for m in gallery.models:
    for c in m.related_concepts:
        concept_count[c] = concept_count.get(c, 0) + 1
for concept, count in sorted(concept_count.items(), key=lambda x: -x[1]):
    bar = "█" * count
    w(f"- **{concept}**: {count} {bar}")
w("")

# Footer
w("---")
w("")
w("*Generated by `gallery_to_md.py` for use with autoresearch agents.*")
w(f"*Fetched: {gallery.fetched_at} · Models: {len(gallery.models)}*")

return "\n".join(lines)
```

def slugify(text: str) -> str:
“”“Create a Markdown-compatible anchor slug.”””
slug = text.lower()
slug = re.sub(r”[^a-z0-9\s-]”, “”, slug)
slug = re.sub(r”[\s]+”, “-”, slug)
return slug.strip(”-”)

