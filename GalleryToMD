def fetch_gallery(force_refresh: bool = False) -> str:
“”“Fetch the gallery HTML, with optional caching.”””
CACHE_DIR.mkdir(exist_ok=True)

```
if not force_refresh and CACHE_HTML.exists():
    age_hours = (time.time() - CACHE_HTML.stat().st_mtime) / 3600
    if age_hours < 24:
        log.info(f"Using cached HTML (age: {age_hours:.1f}h)")
        return CACHE_HTML.read_text(encoding="utf-8")
    else:
        log.info(f"Cache is {age_hours:.1f}h old, refreshing...")

log.info(f"Fetching {GALLERY_URL}")
headers = {"User-Agent": USER_AGENT}
try:
    resp = requests.get(GALLERY_URL, headers=headers, timeout=REQUEST_TIMEOUT)
    resp.raise_for_status()
except requests.RequestException as e:
    if CACHE_HTML.exists():
        log.warning(f"Fetch failed ({e}), falling back to cache")
        return CACHE_HTML.read_text(encoding="utf-8")
    log.error(f"Fetch failed and no cache available: {e}")
    sys.exit(1)

html = resp.text
CACHE_HTML.write_text(html, encoding="utf-8")

# Save metadata
meta = {
    "fetched_at": datetime.now(timezone.utc).isoformat(),
    "url": GALLERY_URL,
    "status_code": resp.status_code,
    "content_length": len(html),
    "content_hash": hashlib.sha256(html.encode()).hexdigest()[:16],
}
CACHE_META.write_text(json.dumps(meta, indent=2), encoding="utf-8")
log.info(f"Fetched {len(html):,} bytes, cached to {CACHE_HTML}")

time.sleep(POLITE_DELAY)
return html
```

